@url = http://127.0.0.1:8000

##
GET {{url}}/api/users


# one request body = one object.
###
POST {{url}}/api/users
Content-Type: application/json

   {
    # id not required will auto-generate in db
    "username": "Emily",
    "email": "Emily@gmail.com",
    "password":"8",
    "date": "{{$datetime iso8601}}"
    }


